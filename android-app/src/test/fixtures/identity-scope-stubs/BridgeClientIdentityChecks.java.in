    public static void main(String[] args) throws Exception {
        try (InstalledApkIdentityScopeChecks.Fixture f = new InstalledApkIdentityScopeChecks.Fixture()) {
            InstalledBridgeBinding binding = InstalledBridgeResolver.resolve(f.context, InstalledApkIdentityScopeChecks.Fixture.GAME);
            BridgeClientIdentityChecks client = new BridgeClientIdentityChecks(f.context, binding, null);
            check(client.homeIdentity != null && client.selected == null, "only installed backend owns identity scope");
            String initial = client.targetGame().installedHash;
            int measurements = DiagnosticTiming.calls;
            AutoCloseable read = client.beginHomeReadIdentityScope();
            check(DiagnosticTiming.calls == measurements + 1, "scope entry measured");
            check(client.targetGame().installedHash.equals(initial), "scoped target retains initial full identity");
            int before = client.trustChecks;
            mutationRejected(() -> client.exchange("restore", null), "restore exchange blocked within read");
            mutationRejected(() -> client.exchange("recover", null), "recover exchange blocked within read");
            check(client.trustChecks == before && BridgeTransport.calls == 0, "mutation blocks before trust/transport");
            client.exchange("inspect", null);
            check(BridgeTransport.calls == 1, "nonmutation inspect exchange permitted");
            read.close();
            check(DiagnosticTiming.calls == measurements + 2, "scope close measured");
            client.homeIdentity.requireNoReadScope();
            client.exchange("recover", null);
            check(BridgeTransport.calls == 2, "mutation proceeds after scope close");

            AutoCloseable invalidated = client.beginHomeReadIdentityScope();
            client.trustFailure = new IOException("Synthetic PM trust failure");
            Failure targetFailure = failed(client::targetGame, "target exception maps to existing failure");
            check("TARGET_IDENTITY_FAILED".equals(targetFailure.code), "target failure code preserved");
            client.trustFailure = null;
            failed(client::targetGame, "restoring trust does not revive scope");
            Failure closeFailure = failed(invalidated::close, "invalidated scope close mapped");
            check(closeFailure.stage == BridgeDiagnostics.Stage.TARGET_IDENTITY
                    && "TARGET_IDENTITY_FAILED".equals(closeFailure.code), "close failure keeps existing diagnostics");
            client.homeIdentity.requireNoReadScope();

            AutoCloseable readFailure = client.beginHomeReadIdentityScope();
            client.trustFailure = new Failure(BridgeDiagnostics.Stage.PACKAGE_TRUST, "EXISTING_FAILURE", "fixture", null);
            Failure same = failed(client::targetGame, "existing failure invalidates");
            check(same == client.trustFailure, "existing target Failure preserved rather than rewrapped");
            client.trustFailure = null;
            failed(readFailure::close, "existing failure scope cannot close successfully");

            AutoCloseable contents = client.beginHomeReadIdentityScope();
            Files.writeString(f.base, "new");
            check(client.targetGame().installedHash.equals(initial), "metadata-equal intermediate target returns scoped identity");
            Failure mismatch = failed(contents::close, "full exit hash mismatch blocks result");
            check(mismatch.getCause() instanceof IOException, "exit mismatch propagated as identity cause");
            check(!client.targetGame().installedHash.equals(initial), "ordinary action target full-checks new bytes");

            android.system.Os.values.get(f.base.toString()).st_size = -1;
            failed(client::beginHomeReadIdentityScope, "begin failure uses identity failure boundary");
            client.homeIdentity.requireNoReadScope();
            android.system.Os.values.get(f.base.toString()).st_size = 3;

            GamePreparationService.PreparedPair prepared = new GamePreparationService.PreparedPair();
            prepared.gamePackage = binding.gamePackage; prepared.sourceApkSetSha256 = binding.sourceApkSetSha256;
            prepared.gameApks = List.of(f.base.toFile(), f.split.toFile());
            BridgeClientIdentityChecks preparedClient = new BridgeClientIdentityChecks(f.context, prepared, new AndroidGameIdentity());
            check(preparedClient.homeIdentity == null, "PreparedPair never receives installed identity scope");
            int timingBefore = DiagnosticTiming.calls;
            try (AutoCloseable noop = preparedClient.beginHomeReadIdentityScope()) {
                preparedClient.targetGame();
                Files.writeString(f.split, "zip");
                String changed = preparedClient.targetGame().installedHash;
                check(changed.equals(PackageTrust.apkSetSha256(prepared.gameApks)), "PreparedPair remains full-check on each target");
            }
            check(timingBefore == DiagnosticTiming.calls, "PreparedPair scope is pure no-op");
            prepared.gameApks = List.of(f.base.toFile());
            check("INSTALLED_APK_SET_MISMATCH".equals(failed(preparedClient::targetGame, "prepared mismatch still rejected").code), "PreparedPair original mismatch protection retained");

            android.os.Build.VERSION.SDK_INT = 26;
            int before26 = DiagnosticTiming.calls;
            try (AutoCloseable noop = client.beginHomeReadIdentityScope()) {
                client.homeIdentity.requireNoReadScope();
                String old = client.targetGame().installedHash;
                Files.writeString(f.base, "api");
                check(!old.equals(client.targetGame().installedHash), "API26 installed client still full-checks each request");
            }
            check(DiagnosticTiming.calls == before26 + 2, "API26 keeps timing wrapper with no-op identity scope");
        }
        System.out.println("Reconstructed BridgeClient identity wiring: " + checks + " assertions passed. Extracted production methods, host-only edges.");
    }

