pkgname=pdsync
pkgver=0.0.0
pkgrel=1
pkgdesc='Pixel Dungeon save synchronization (bundled Java runtime)'
arch=('x86_64')
url='https://github.com/xyz1001/pixel-dungeon-sync'
license=('custom')
depends=('glibc' 'gcc-libs' 'zlib' 'freetype2' 'fontconfig' 'libx11' 'libxext' 'libxi' 'libxrender' 'libxtst' 'alsa-lib' 'libglvnd')
options=('!strip' '!debug')
package() {
    install -d "$pkgdir/opt/pdsync" "$pkgdir/usr/bin" "$pkgdir/usr/share/applications"
    cp -a "$startdir/image/." "$pkgdir/opt/pdsync/"
    local launchers=("$pkgdir"/opt/pdsync/bin/*)
    [[ ${#launchers[@]} == 1 && -f "${launchers[0]}" ]] || return 1
    local launcher="${launchers[0]##*/}"
    [[ ${launcher,,} == pdsync ]] || return 1
    ln -s "/opt/pdsync/bin/$launcher" "$pkgdir/usr/bin/pdsync"
    printf '[Desktop Entry]\nType=Application\nName=PDSync\nExec=/usr/bin/pdsync\nCategories=Game;Utility;\nTerminal=false\n' > "$pkgdir/usr/share/applications/pdsync.desktop"
    local icons=("$pkgdir"/opt/pdsync/lib/*.png)
    [[ ${#icons[@]} == 1 && -f "${icons[0]}" ]] || return 1
    printf 'Icon=/opt/pdsync/lib/%s\n' "${icons[0]##*/}" >> "$pkgdir/usr/share/applications/pdsync.desktop"
}
